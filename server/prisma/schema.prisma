generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model actionLog {
  id             String    @id @default(uuid())
  grievanceId    String
  action         String
  performedBy    String
  attachmentPath String?
  timestamp      DateTime  @default(now())
  grievance      grievance @relation(fields: [grievanceId], references: [id], map: "ActionLog_grievanceId_fkey")

  @@index([grievanceId], map: "ActionLog_grievanceId_fkey")
}

model grievance {
  id                 String      @id @default(uuid())
  grievanceId        String      @unique(map: "Grievance_grievanceId_key")
  name               String
  mobile             String
  address            String
  category           String
  description        String
  status             String      @default("PENDING")
  subStatus          String?
  isEscalated        Boolean     @default(false)
  escalationLevel    Int         @default(0)
  hearingDate        String?
  hearingTime        String?
  hearingLink        String?
  assignedOfficer    String?
  assignedSection    String?
  assignedZone       String?
  expectedDate       String?
  remarks            String?
  attachmentPath     String?
  source             String      @default("WEB_PORTAL")
  eeRemarks          String?
  eeStatus           String?
  eeActionDate       DateTime?
  directorNote       String?
  isReopened         Boolean     @default(false)
  reopenedBy         String?
  reopenReason       String?
  assignedToId       String?
  wardNo             Int?
  subject            String?
  createdAt          DateTime    @default(now())
  satisfactionStatus String?
  citizenFeedback    String?
  vcScheduledDate    DateTime?
  vcMeetingLink      String?
  updatedAt          DateTime    @updatedAt
  logs               actionLog[]
  user               user?       @relation(fields: [assignedToId], references: [id], map: "Grievance_assignedToId_fkey")

  @@index([assignedToId], map: "Grievance_assignedToId_fkey")
}

model user {
  id        String      @id @default(uuid())
  name      String
  username  String      @unique(map: "User_username_key")
  password  String
  email     String?     @unique(map: "User_email_key")
  role      String
  section   String?
  zone      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  grievance grievance[]
}
