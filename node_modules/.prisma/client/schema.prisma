generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  username  String   @unique
  password  String
  email     String?  @unique
  role      String // SUPER_ADMIN, MODERATOR, SECTION_OFFICER, OPERATOR, EXECUTIVE_ENGINEER
  section   String?
  zone      String? // For Executive Engineers
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedGrievances Grievance[] @relation("AssignedTo")
}

model Grievance {
  id              String  @id @default(uuid())
  grievanceId     String  @unique
  name            String
  mobile          String
  address         String
  category        String
  description     String
  status          String  @default("PENDING")
  subStatus       String? // e.g., ASSIGNED_TO_EE
  isEscalated     Boolean @default(false)
  escalationLevel Int     @default(0)
  hearingDate     String?
  hearingTime     String?
  hearingLink     String?
  assignedOfficer String?
  assignedSection String?
  assignedZone    String?
  expectedDate    String?
  remarks         String?
  attachmentPath  String?
  source          String  @default("WEB_PORTAL")

  // Engineering specific fields
  eeRemarks    String?
  eeStatus     String?
  eeActionDate DateTime?
  directorNote String?

  // Re-opening & High Level Monitoring
  isReopened   Boolean @default(false)
  reopenedBy   String? // Name/Role of who reopened it
  reopenReason String? // Reason for reopening

  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedToId String?

  createdAt          DateTime  @default(now())
  // Satisfaction Workflow
  satisfactionStatus String? // PENDING_FEEDBACK, SATISFIED, NOT_SATISFIED, VC_SCHEDULED, VC_DONE, SATISFIED_POST_VC, NOT_SATISFIED_POST_VC, CLOSED_HIGHER_W_VC
  citizenFeedback    String? // YES, NO
  vcScheduledDate    DateTime?
  vcMeetingLink      String?

  updatedAt DateTime @updatedAt

  logs ActionLog[]
}

model ActionLog {
  id             String    @id @default(uuid())
  grievance      Grievance @relation(fields: [grievanceId], references: [id])
  grievanceId    String
  action         String
  performedBy    String
  attachmentPath String?
  timestamp      DateTime  @default(now())
}
